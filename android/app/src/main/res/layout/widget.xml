<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/fondo" android:padding="12dp">

    <!-- Widget v2 (20 nov): arriba favoritos perdiendo, abajo el estado de BetPlay y Rushbet -->
    <LinearLayout android:id="@+id/cabecera"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/vivos" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="–" android:textColor="#E8F0EA" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text=" favoritos perdiendo" android:textColor="#9DB2A6" android:textSize="13sp" />
        <TextView android:id="@+id/actualizar" android:layout_width="36dp" android:layout_height="36dp"
            android:gravity="center" android:text="⟳" android:textColor="#3DDC84" android:textSize="20sp" />
    </LinearLayout>

    <TextView android:id="@+id/hora" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="cargando…" android:textColor="#9DB2A6" android:textSize="11sp" android:paddingBottom="6dp" />

    <ListView android:id="@+id/lista" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:divider="@null" android:dividerHeight="0dp" />

    <TextView android:id="@+id/lista_simple" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:textColor="#E8F0EA" android:textSize="12sp" android:visibility="gone" />

    <TextView android:id="@+id/vacio" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:text="Ningún favorito va perdiendo ahora" android:textColor="#9DB2A6"
        android:textSize="12sp" android:visibility="gone" />

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#25382F"
        android:layout_marginTop="6dp" android:layout_marginBottom="6dp" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="TUS CASAS" android:textColor="#9DB2A6" android:textSize="11sp" android:textStyle="bold"
        android:paddingBottom="4dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/casa"
            android:padding="8dp" android:layout_marginEnd="4dp">
            <TextView android:id="@+id/led_betplay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="#9DB2A6" android:textSize="14sp" android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="BetPlay" android:textColor="#E8F0EA" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/estado_betplay" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="…" android:maxLines="1" android:ellipsize="end" android:textColor="#9DB2A6" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/casa"
            android:padding="8dp" android:layout_marginStart="4dp">
            <TextView android:id="@+id/led_rushbet" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="●" android:textColor="#9DB2A6" android:textSize="14sp" android:paddingEnd="6dp" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Rushbet" android:textColor="#E8F0EA" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/estado_rushbet" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="…" android:maxLines="1" android:ellipsize="end" android:textColor="#9DB2A6" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
